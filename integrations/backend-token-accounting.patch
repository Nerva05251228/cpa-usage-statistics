@@ -0,0 +1,101 @@
+package pluginhost
+
+import (
+	"context"
+	"testing"
+
+	coreusage "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/usage"
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+)
+
+func TestUsageAdapterDeliversCanonicalTokenBreakdown(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		provider     string
+		executorType string
+		detail       coreusage.Detail
+		want         coreusage.TokenBreakdown
+	}{
+		{
+			name:     "OpenAI cache and reasoning are subsets",
+			provider: "openai",
+			detail: coreusage.Detail{
+				InputTokens: 100, OutputTokens: 30, ReasoningTokens: 12,
+				CacheReadTokens: 40, CacheCreationTokens: 10,
+			},
+			want: coreusage.TokenBreakdown{
+				SchemaVersion: 2, Quality: coreusage.TokenAccountingQualityComplete, TotalTokens: 130,
+				Input:  coreusage.TokenInputBreakdown{TotalTokens: 100, UncachedTokens: 50, CacheReadTokens: 40, CacheWriteTokens: 10},
+				Output: coreusage.TokenOutputBreakdown{TotalTokens: 30, NonReasoningTokens: 18, ReasoningTokens: 12},
+			},
+		},
+		{
+			name:         "Claude executor buckets are independent",
+			provider:     "custom-provider",
+			executorType: "claude",
+			detail: coreusage.Detail{
+				InputTokens: 30, OutputTokens: 5, ReasoningTokens: 2,
+				CacheReadTokens: 7, CacheCreationTokens: 13,
+			},
+			want: coreusage.TokenBreakdown{
+				SchemaVersion: 2, Quality: coreusage.TokenAccountingQualityComplete, TotalTokens: 57,
+				Input:  coreusage.TokenInputBreakdown{TotalTokens: 50, UncachedTokens: 30, CacheReadTokens: 7, CacheWriteTokens: 13},
+				Output: coreusage.TokenOutputBreakdown{TotalTokens: 7, NonReasoningTokens: 5, ReasoningTokens: 2},
+			},
+		},
+		{
+			name:     "unknown provider remains unclassified",
+			provider: "custom-provider",
+			detail: coreusage.Detail{
+				InputTokens: 100, OutputTokens: 30, ReasoningTokens: 12, CacheReadTokens: 40,
+			},
+			want: coreusage.TokenBreakdown{
+				SchemaVersion: 2, Quality: coreusage.TokenAccountingQualityUnclassified,
+				TotalTokens: 130, UnclassifiedTokens: 130,
+			},
+		},
+		{
+			name:     "existing canonical detail survives unknown provider",
+			provider: "custom-provider",
+			detail: coreusage.Detail{
+				TokenBreakdown: coreusage.TokenBreakdown{
+					SchemaVersion: 2, Quality: coreusage.TokenAccountingQualityComplete, TotalTokens: 25,
+					Input:  coreusage.TokenInputBreakdown{TotalTokens: 20, UncachedTokens: 10, CacheReadTokens: 10},
+					Output: coreusage.TokenOutputBreakdown{TotalTokens: 5, NonReasoningTokens: 3, ReasoningTokens: 2},
+				},
+			},
+			want: coreusage.TokenBreakdown{
+				SchemaVersion: 2, Quality: coreusage.TokenAccountingQualityComplete, TotalTokens: 25,
+				Input:  coreusage.TokenInputBreakdown{TotalTokens: 20, UncachedTokens: 10, CacheReadTokens: 10},
+				Output: coreusage.TokenOutputBreakdown{TotalTokens: 5, NonReasoningTokens: 3, ReasoningTokens: 2},
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var got pluginapi.UsageRecord
+			host := newHostWithRecords(capabilityRecord{
+				id: "usage-accounting",
+				plugin: pluginapi.Plugin{Capabilities: pluginapi.Capabilities{
+					UsagePlugin: usagePluginFunc(func(_ context.Context, record pluginapi.UsageRecord) {
+						got = record
+					}),
+				}},
+			})
+			adapter := &usageAdapter{host: host, pluginID: "usage-accounting"}
+			adapter.HandleUsage(context.Background(), coreusage.Record{
+				Provider: tc.provider, ExecutorType: tc.executorType, Detail: tc.detail,
+			})
+			if got.Detail.TokenBreakdown != tc.want {
+				t.Fatalf("TokenBreakdown = %+v, want %+v", got.Detail.TokenBreakdown, tc.want)
+			}
+			if got.Detail.TotalTokens != tc.want.TotalTokens {
+				t.Fatalf("TotalTokens = %d, want %d", got.Detail.TotalTokens, tc.want.TotalTokens)
+			}
+			if got.Detail.InputTokens != tc.detail.InputTokens || got.Detail.OutputTokens != tc.detail.OutputTokens ||
+				got.Detail.ReasoningTokens != tc.detail.ReasoningTokens || got.Detail.CacheReadTokens != tc.detail.CacheReadTokens ||
+				got.Detail.CacheCreationTokens != tc.detail.CacheCreationTokens {
+				t.Fatalf("legacy counters changed: got %+v, original %+v", got.Detail, tc.detail)
+			}
+		})
+	}
+}
