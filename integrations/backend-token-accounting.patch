diff --git a/sdk/pluginapi/usage_accounting_test.go b/sdk/pluginapi/usage_accounting_test.go
new file mode 100644
index 00000000..99a74e35
--- /dev/null
+++ b/sdk/pluginapi/usage_accounting_test.go
@@ -0,0 +1,46 @@
+package pluginapi
+
+import (
+	"encoding/json"
+	"testing"
+
+	coreusage "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/usage"
+)
+
+func TestUsageRecordCanonicalTokenBreakdownWireFormat(t *testing.T) {
+	record := UsageRecord{Detail: UsageDetail{
+		InputTokens: 100, OutputTokens: 30, TotalTokens: 130,
+		TokenBreakdown: coreusage.NewSubsetTokenBreakdown(100, 40, 10, 30, 12, 130),
+	}}
+	wire, errMarshal := json.Marshal(record)
+	if errMarshal != nil {
+		t.Fatal(errMarshal)
+	}
+	var decoded struct {
+		Detail struct {
+			TokenBreakdown json.RawMessage
+		}
+	}
+	if errUnmarshal := json.Unmarshal(wire, &decoded); errUnmarshal != nil {
+		t.Fatal(errUnmarshal)
+	}
+	const want = `{"schema_version":2,"quality":"complete","total_tokens":130,"input":{"total_tokens":100,"uncached_tokens":50,"cache_read_tokens":40,"cache_write_tokens":10},"output":{"total_tokens":30,"non_reasoning_tokens":18,"reasoning_tokens":12},"unclassified_tokens":0}`
+	if string(decoded.Detail.TokenBreakdown) != want {
+		t.Fatalf("Detail.TokenBreakdown = %s, want %s", decoded.Detail.TokenBreakdown, want)
+	}
+
+	// Existing schema-6 consumers can ignore the additive canonical field.
+	var legacy struct {
+		Detail struct {
+			InputTokens  int64
+			OutputTokens int64
+			TotalTokens  int64
+		}
+	}
+	if errUnmarshal := json.Unmarshal(wire, &legacy); errUnmarshal != nil {
+		t.Fatal(errUnmarshal)
+	}
+	if legacy.Detail.InputTokens != 100 || legacy.Detail.OutputTokens != 30 || legacy.Detail.TotalTokens != 130 {
+		t.Fatalf("legacy token counters = %+v", legacy.Detail)
+	}
+}
diff --git a/internal/pluginhost/adapters_usage_accounting_test.go b/internal/pluginhost/adapters_usage_accounting_test.go
