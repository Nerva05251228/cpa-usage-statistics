diff --git a/src/features/plugins/pluginBridge.ts b/src/features/plugins/pluginBridge.ts
new file mode 100644
index 0000000..9f916b0
--- /dev/null
+++ b/src/features/plugins/pluginBridge.ts
@@ -0,0 +1,229 @@
+import { isRecord } from '@/utils/helpers';
+
+export const PLUGIN_BRIDGE_CHANNEL = 'cpa-plugin-bridge';
+export const PLUGIN_BRIDGE_VERSION = 1;
+
+export type PluginBridgeMethod = 'GET' | 'POST' | 'PUT';
+
+export interface PluginBridgeRequest {
+  method: PluginBridgeMethod;
+  path: string;
+  body?: unknown;
+}
+
+export interface PluginBridgeContext {
+  theme: 'light' | 'dark';
+  language: string;
+}
+
+interface BridgePolicy {
+  routes: Record<PluginBridgeMethod, readonly string[]>;
+  queryKeys: Record<string, readonly string[]>;
+}
+
+// A menu alone never grants management access. Each supported plugin opts in
+// to a small set of its own endpoints. The client-key directory is synthesized
+// by the parent with fingerprints and masked labels; core APIs are never exposed.
+const policies: Record<string, BridgePolicy> = {
+  'cpa-usage-statistics': {
+    routes: {
+      GET: ['/usage', '/usage/export', '/billing', '/health', '/sources', '/client-keys'],
+      POST: ['/usage/import'],
+      PUT: ['/billing'],
+    },
+    queryKeys: { '/usage': ['page_size', 'page', 'from', 'to'] },
+  },
+};
+
+export function resolvePluginBridgeRequest(
+  pluginId: string,
+  method: unknown,
+  path: unknown
+): Omit<PluginBridgeRequest, 'body'> | null {
+  const policy = Object.prototype.hasOwnProperty.call(policies, pluginId)
+    ? policies[pluginId]
+    : undefined;
+  if (!policy || (method !== 'GET' && method !== 'POST' && method !== 'PUT')) return null;
+  if (typeof path !== 'string' || path.length > 4096 || path.includes('#')) return null;
+
+  // Check the literal pathname before URL normalization, so encoded or plain
+  // traversal, absolute URLs, duplicate slashes and backslashes cannot escape.
+  const queryStart = path.indexOf('?');
+  const pathname = queryStart === -1 ? path : path.slice(0, queryStart);
+  if (!policy.routes[method].includes(pathname)) return null;
+
+  const query = new URLSearchParams(queryStart === -1 ? '' : path.slice(queryStart + 1));
+  const allowedKeys = method === 'GET' ? (policy.queryKeys[pathname] ?? []) : [];
+  const seenKeys = new Set<string>();
+  for (const [key] of query) {
+    if (!allowedKeys.includes(key) || seenKeys.has(key)) return null;
+    seenKeys.add(key);
+  }
+  const suffix = query.size ? `?${query.toString()}` : '';
+  return {
+    method,
+    path: `/plugins/${encodeURIComponent(pluginId)}${pathname}${suffix}`,
+  };
+}
+
+export function resolvePluginBridgeOrigin(
+  pluginId: string,
+  frameSrc: string,
+  apiBase: string,
+  hostURL: string
+): string | null {
+  if (!Object.prototype.hasOwnProperty.call(policies, pluginId)) return null;
+  try {
+    const frame = new URL(frameSrc, hostURL);
+    const backend = new URL(`${apiBase.replace(/\/+$/, '')}/`, hostURL);
+    const resource = new URL(`v0/resource/plugins/${encodeURIComponent(pluginId)}/`, backend);
+    if (
+      !['https:', 'http:'].includes(frame.protocol) ||
+      frame.username ||
+      frame.password ||
+      frame.origin !== resource.origin ||
+      !frame.pathname.startsWith(resource.pathname)
+    ) {
+      return null;
+    }
+    return frame.origin;
+  } catch {
+    return null;
+  }
+}
+
+interface BridgeFrame {
+  postMessage(message: unknown, targetOrigin: string): void;
+}
+
+interface BridgeOptions {
+  pluginId: string;
+  frame: BridgeFrame;
+  origin: string;
+  context: PluginBridgeContext;
+  isActive: () => boolean;
+  request: (request: PluginBridgeRequest, signal: AbortSignal) => Promise<unknown>;
+  createSessionId: () => string;
+}
+
+export interface PluginBridge {
+  receive: (event: { source: unknown; origin: string; data: unknown }) => void;
+  reset: () => void;
+  updateContext: (context: PluginBridgeContext) => void;
+  refresh: () => boolean;
+  dispose: () => void;
+}
+
+export function createPluginBridge(options: BridgeOptions): PluginBridge {
+  let active = true;
+  let sessionId = options.createSessionId();
+  let context = options.context;
+  const pending = new Map<string, AbortController>();
+  const isCurrent = (session = sessionId) => active && options.isActive() && session === sessionId;
+
+  const send = (payload: Record<string, unknown>) => {
+    if (!isCurrent()) return;
+    options.frame.postMessage(
+      {
+        channel: PLUGIN_BRIDGE_CHANNEL,
+        version: PLUGIN_BRIDGE_VERSION,
+        sessionId,
+        ...payload,
+      },
+      options.origin
+    );
+  };
+  const initialize = () => send({ type: 'init', pluginId: options.pluginId, ...context });
+  const cancelPending = () => {
+    for (const controller of pending.values()) controller.abort();
+    pending.clear();
+  };
+
+  const receive: PluginBridge['receive'] = (event) => {
+    if (
+      !isCurrent() ||
+      event.source !== options.frame ||
+      event.origin !== options.origin ||
+      !isRecord(event.data)
+    ) {
+      return;
+    }
+    const message = event.data;
+    if (message.channel !== PLUGIN_BRIDGE_CHANNEL || message.version !== PLUGIN_BRIDGE_VERSION) {
+      return;
+    }
+    if (message.type === 'ready') {
+      initialize();
+      return;
+    }
+    if (
+      message.type !== 'request' ||
+      message.sessionId !== sessionId ||
+      typeof message.id !== 'string' ||
+      !message.id ||
+      message.id.length > 128
+    ) {
+      return;
+    }
+
+    const id = message.id;
+    if (pending.has(id)) return;
+    const route = resolvePluginBridgeRequest(options.pluginId, message.method, message.path);
+    if (!route || pending.size >= 32) {
+      send({
+        type: 'response',
+        id,
+        ok: false,
+        error: { message: 'Plugin request is not allowed.' },
+      });
+      return;
+    }
+
+    const requestSession = sessionId;
+    const controller = new AbortController();
+    pending.set(id, controller);
+    void (async () => {
+      try {
+        const data = await options.request({ ...route, body: message.body }, controller.signal);
+        if (isCurrent(requestSession)) send({ type: 'response', id, ok: true, data });
+      } catch (error: unknown) {
+        if (!isCurrent(requestSession)) return;
+        // Never forward Axios objects, headers, request config or server details.
+        const status =
+          error instanceof Error && 'status' in error && typeof error.status === 'number'
+            ? error.status
+            : undefined;
+        send({
+          type: 'response',
+          id,
+          ok: false,
+          error: { message: 'Plugin request failed.', ...(status ? { status } : {}) },
+        });
+      } finally {
+        if (pending.get(id) === controller) pending.delete(id);
+      }
+    })();
+  };
+
+  return {
+    receive,
+    reset: () => {
+      cancelPending();
+      sessionId = options.createSessionId();
+      initialize();
+    },
+    updateContext: (next) => {
+      context = next;
+      initialize();
+    },
+    refresh: () => {
+      if (!isCurrent()) return false;
+      send({ type: 'refresh' });
+      return true;
+    },
+    dispose: () => {
+      active = false;
+      cancelPending();
+    },
+  };
+}
diff --git a/src/features/plugins/usePluginBridge.ts b/src/features/plugins/usePluginBridge.ts
new file mode 100644
index 0000000..7bfcdb4
--- /dev/null
+++ b/src/features/plugins/usePluginBridge.ts
@@ -0,0 +1,85 @@
+import { useCallback, useLayoutEffect, useRef, type RefObject } from 'react';
+import { requestPluginResource } from '@/services/api/pluginResources';
+import { useAuthStore } from '@/stores';
+import {
+  createPluginBridge,
+  resolvePluginBridgeOrigin,
+  type PluginBridge,
+  type PluginBridgeContext,
+} from './pluginBridge';
+
+interface PluginBridgeOptions extends PluginBridgeContext {
+  frameRef: RefObject<HTMLIFrameElement | null>;
+  frameKey: string;
+  frameSrc: string;
+  pluginId: string;
+  enabled: boolean;
+}
+
+export function usePluginBridge({
+  frameRef,
+  frameKey,
+  frameSrc,
+  pluginId,
+  enabled,
+  theme,
+  language,
+}: PluginBridgeOptions) {
+  const apiBase = useAuthStore((state) => state.apiBase);
+  const managementKey = useAuthStore((state) => state.managementKey);
+  const bridgeRef = useRef<PluginBridge | null>(null);
+  const contextRef = useRef({ theme, language });
+
+  useLayoutEffect(() => {
+    contextRef.current = { theme, language };
+    bridgeRef.current?.updateContext(contextRef.current);
+  }, [theme, language]);
+
+  useLayoutEffect(() => {
+    const frame = frameRef.current?.contentWindow;
+    const origin = resolvePluginBridgeOrigin(pluginId, frameSrc, apiBase, window.location.href);
+    if (!enabled || !frame || !origin) return;
+
+    const isActive = () => {
+      const state = useAuthStore.getState();
+      return (
+        state.isAuthenticated &&
+        state.connectionStatus === 'connected' &&
+        state.apiBase === apiBase &&
+        state.managementKey === managementKey &&
+        frameRef.current?.contentWindow === frame
+      );
+    };
+    const bridge = createPluginBridge({
+      frame,
+      origin,
+      pluginId,
+      context: contextRef.current,
+      isActive,
+      request: requestPluginResource,
+      createSessionId: () =>
+        Array.from(window.crypto.getRandomValues(new Uint8Array(16)), (byte) =>
+          byte.toString(16).padStart(2, '0')
+        ).join(''),
+    });
+    bridgeRef.current = bridge;
+    window.addEventListener('message', bridge.receive);
+    // Invalidate synchronously on logout/reconnect, even if React has not yet
+    // committed the next render, or the same connection is quickly restored.
+    const unsubscribe = useAuthStore.subscribe(() => {
+      if (!isActive()) bridge.dispose();
+    });
+    bridge.updateContext(contextRef.current);
+
+    return () => {
+      unsubscribe();
+      window.removeEventListener('message', bridge.receive);
+      bridge.dispose();
+      if (bridgeRef.current === bridge) bridgeRef.current = null;
+    };
+  }, [apiBase, enabled, frameKey, frameRef, frameSrc, managementKey, pluginId]);
+
+  const onLoad = useCallback(() => bridgeRef.current?.reset(), []);
+  const refresh = useCallback(() => bridgeRef.current?.refresh() ?? false, []);
+  return { onLoad, refresh };
+}
diff --git a/src/features/plugins/clientKeyIdentities.ts b/src/features/plugins/clientKeyIdentities.ts
new file mode 100644
index 0000000..d9ad4e1
--- /dev/null
+++ b/src/features/plugins/clientKeyIdentities.ts
@@ -0,0 +1,20 @@
+import { sha256 } from '@noble/hashes/sha2.js';
+import { bytesToHex, utf8ToBytes } from '@noble/hashes/utils.js';
+import { maskApiKey } from '@/utils/format';
+
+export interface PluginClientKeyIdentity {
+  id: string;
+  label: string;
+}
+
+// Match the plugin's rawOpaque("key", value) without sharing real keys with
+// its iframe. Noble also works on HTTP origins without Web Crypto SubtleCrypto.
+export function createPluginClientKeyIdentities(
+  keys: readonly string[]
+): PluginClientKeyIdentity[] {
+  const distinctKeys = new Set(keys.map((key) => key.trim()).filter(Boolean));
+  return Array.from(distinctKeys, (key) => ({
+    id: `key-${bytesToHex(sha256(utf8ToBytes(key))).slice(0, 24)}`,
+    label: key.length <= 4 ? '**********' : maskApiKey(key),
+  }));
+}
diff --git a/src/services/api/pluginResources.ts b/src/services/api/pluginResources.ts
new file mode 100644
index 0000000..04094f7
--- /dev/null
+++ b/src/services/api/pluginResources.ts
@@ -0,0 +1,21 @@
+import type { PluginBridgeRequest } from '@/features/plugins/pluginBridge';
+import { createPluginClientKeyIdentities } from '@/features/plugins/clientKeyIdentities';
+import { apiKeysApi } from './apiKeys';
+import { apiClient } from './client';
+
+// Only validated, plugin-scoped routes from pluginBridge reach this adapter.
+export const requestPluginResource = async (request: PluginBridgeRequest, signal: AbortSignal) => {
+  if (request.method === 'GET' && request.path === '/plugins/cpa-usage-statistics/client-keys') {
+    const keys = await apiKeysApi.list({ signal });
+    signal.throwIfAborted();
+    return { keys: createPluginClientKeyIdentities(keys) };
+  }
+  switch (request.method) {
+    case 'GET':
+      return apiClient.get(request.path, { signal });
+    case 'POST':
+      return apiClient.post(request.path, request.body, { signal });
+    case 'PUT':
+      return apiClient.put(request.path, request.body, { signal });
+  }
+};
diff --git a/tests/pluginBridge.test.ts b/tests/pluginBridge.test.ts
new file mode 100644
index 0000000..bf04d7a
--- /dev/null
+++ b/tests/pluginBridge.test.ts
@@ -0,0 +1,348 @@
+import { describe, expect, test } from 'bun:test';
+import {
+  createPluginBridge,
+  PLUGIN_BRIDGE_CHANNEL,
+  PLUGIN_BRIDGE_VERSION,
+  resolvePluginBridgeOrigin,
+  resolvePluginBridgeRequest,
+  type PluginBridgeRequest,
+} from '../src/features/plugins/pluginBridge';
+
+const pluginId = 'cpa-usage-statistics';
+const origin = 'https://proxy.example';
+const frameURL = `${origin}/v0/resource/plugins/${pluginId}/index.html`;
+const tick = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (error: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+function harness(request = async (_request: PluginBridgeRequest, _signal: AbortSignal) => ({})) {
+  let current = true;
+  let counter = 0;
+  const sent: { data: unknown; origin: string }[] = [];
+  const calls: { request: PluginBridgeRequest; signal: AbortSignal }[] = [];
+  const frame = {
+    postMessage: (data: unknown, targetOrigin: string) => {
+      sent.push({ data, origin: targetOrigin });
+    },
+  };
+  const bridge = createPluginBridge({
+    pluginId,
+    frame,
+    origin,
+    context: { theme: 'dark', language: 'zh-CN' },
+    isActive: () => current,
+    createSessionId: () => `session-${++counter}`,
+    request: (payload, signal) => {
+      calls.push({ request: payload, signal });
+      return request(payload, signal);
+    },
+  });
+  const envelope = (data: Record<string, unknown>) => ({
+    channel: PLUGIN_BRIDGE_CHANNEL,
+    version: PLUGIN_BRIDGE_VERSION,
+    ...data,
+  });
+  const receive = (data: Record<string, unknown>) =>
+    bridge.receive({ source: frame, origin, data: envelope(data) });
+  const query = (overrides: Record<string, unknown> = {}) =>
+    receive({
+      type: 'request',
+      sessionId: 'session-1',
+      id: 'request-1',
+      method: 'GET',
+      path: '/usage',
+      ...overrides,
+    });
+  return {
+    bridge,
+    frame,
+    sent,
+    calls,
+    receive,
+    query,
+    envelope,
+    setCurrent: (value: boolean) => {
+      current = value;
+    },
+  };
+}
+
+describe('plugin bridge endpoint policy', () => {
+  test('allows the statistics endpoints only within their plugin namespace', () => {
+    for (const path of [
+      '/usage',
+      '/usage/export',
+      '/billing',
+      '/health',
+      '/sources',
+      '/client-keys',
+    ]) {
+      expect(resolvePluginBridgeRequest(pluginId, 'GET', path)).toEqual({
+        method: 'GET',
+        path: `/plugins/${pluginId}${path}`,
+      });
+    }
+    expect(resolvePluginBridgeRequest(pluginId, 'POST', '/usage/import')?.path).toBe(
+      `/plugins/${pluginId}/usage/import`
+    );
+    expect(resolvePluginBridgeRequest(pluginId, 'PUT', '/billing')?.path).toBe(
+      `/plugins/${pluginId}/billing`
+    );
+  });
+
+  test('rejects core APIs, other plugins, method changes and path traversal', () => {
+    for (const path of [
+      '/config',
+      '/api-keys',
+      '/auth-files',
+      '/plugins/other/usage',
+      '/usage/../../config',
+      '/usage/..%2f../config',
+      '/%75sage',
+      '/usage/',
+      '//usage',
+      '/usage\\..\\config',
+      'https://attacker.example/usage',
+      '/usage#fragment',
+      '/client-keys/',
+      '/client-keys/../api-keys',
+      '/client-keys?raw=true',
+    ]) {
+      expect(resolvePluginBridgeRequest(pluginId, 'GET', path)).toBeNull();
+    }
+    expect(resolvePluginBridgeRequest(pluginId, 'DELETE', '/usage')).toBeNull();
+    expect(resolvePluginBridgeRequest(pluginId, 'POST', '/billing')).toBeNull();
+    expect(resolvePluginBridgeRequest(pluginId, 'PUT', '/usage/import')).toBeNull();
+    expect(resolvePluginBridgeRequest('other-plugin', 'GET', '/usage')).toBeNull();
+    expect(resolvePluginBridgeRequest('toString', 'GET', '/usage')).toBeNull();
+    expect(resolvePluginBridgeRequest(pluginId, 'POST', '/client-keys')).toBeNull();
+    expect(resolvePluginBridgeRequest(pluginId, 'PUT', '/client-keys')).toBeNull();
+    expect(resolvePluginBridgeRequest('other-plugin', 'GET', '/client-keys')).toBeNull();
+  });
+
+  test('normalizes allowed query values and rejects unknown or duplicate query keys', () => {
+    expect(
+      resolvePluginBridgeRequest(pluginId, 'GET', '/usage?page=2&page_size=50&from=a/b?c=d')
+    ).toEqual({
+      method: 'GET',
+      path: `/plugins/${pluginId}/usage?page=2&page_size=50&from=a%2Fb%3Fc%3Dd`,
+    });
+    for (const path of [
+      '/usage?path=/config',
+      '/usage?page=1&page=2',
+      '/usage?__proto__=value',
+      '/billing?page=1',
+      '/usage/export?page=1',
+    ]) {
+      expect(resolvePluginBridgeRequest(pluginId, 'GET', path)).toBeNull();
+    }
+    expect(resolvePluginBridgeRequest(pluginId, 'PUT', '/billing?from=0')).toBeNull();
+  });
+
+  test('grants the bridge only to the installed plugin resource on the configured backend', () => {
+    expect(resolvePluginBridgeOrigin(pluginId, frameURL, origin, origin)).toBe(origin);
+    expect(
+      resolvePluginBridgeOrigin(
+        pluginId,
+        `${origin}/prefix/v0/resource/plugins/${pluginId}/index.html`,
+        `${origin}/prefix`,
+        'http://localhost:5173'
+      )
+    ).toBe(origin);
+    for (const url of [
+      'https://attacker.example/index.html',
+      `https://proxy.example.attacker.example/v0/resource/plugins/${pluginId}/index.html`,
+      `${origin}/v0/resource/plugins/other/index.html`,
+      `${origin}/v0/resource/plugins/${pluginId}-lookalike/index.html`,
+      `${origin}/v0/resource/plugins/${pluginId}/../other/index.html`,
+      'data:text/html,hello',
+      'blob:https://proxy.example/id',
+      'https://user:password@proxy.example/index.html',
+    ]) {
+      expect(resolvePluginBridgeOrigin(pluginId, url, origin, origin)).toBeNull();
+    }
+    expect(resolvePluginBridgeOrigin('other', frameURL, origin, origin)).toBeNull();
+  });
+});
