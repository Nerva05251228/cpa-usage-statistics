+import { afterEach, describe, expect, test } from 'bun:test';
+import { createPluginClientKeyIdentities } from '../src/features/plugins/clientKeyIdentities';
+import { apiClient } from '../src/services/api/client';
+import { apiKeysApi } from '../src/services/api/apiKeys';
+import { requestPluginResource } from '../src/services/api/pluginResources';
+
+const originalGet = apiClient.get;
+const originalPut = apiClient.put;
+const originalPost = apiClient.post;
+const directoryPath = '/plugins/cpa-usage-statistics/client-keys';
+
+afterEach(() => {
+  apiClient.get = originalGet;
+  apiClient.put = originalPut;
+  apiClient.post = originalPost;
+});
+
+describe('plugin client-key identities', () => {
+  test('matches Go SHA-256 fingerprints with whitespace normalization', () => {
+    // Standard SHA-256 vectors also match Go crypto/sha256 + hex.EncodeToString.
+    expect(createPluginClientKeyIdentities([' \tabc\n ', 'abc', '', ' '])).toEqual([
+      { id: 'key-ba7816bf8f01cfea414140de', label: '**********' },
+    ]);
+    expect(
+      createPluginClientKeyIdentities(['abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq'])
+    ).toEqual([{ id: 'key-248d6a61d20638b8e5c02693', label: 'ab******pq' }]);
+  });
+
+  test('works without browser SubtleCrypto on an insecure HTTP origin', () => {
+    const descriptor = Object.getOwnPropertyDescriptor(globalThis, 'crypto');
+    try {
+      Object.defineProperty(globalThis, 'crypto', { configurable: true, value: {} });
+      expect(createPluginClientKeyIdentities(['abc'])[0].id).toBe('key-ba7816bf8f01cfea414140de');
+    } finally {
+      if (descriptor) Object.defineProperty(globalThis, 'crypto', descriptor);
+      else Reflect.deleteProperty(globalThis, 'crypto');
+    }
+  });
+
+  test('fully masks short keys and returns only fingerprints and masked labels', () => {
+    const keys = ['x', 'xy', 'xyz', 'xyzw', 'test-client-key-abc123'];
+    const identities = createPluginClientKeyIdentities(keys);
+    expect(identities.slice(0, 4).map((entry) => entry.label)).toEqual([
+      '**********',
+      '**********',
+      '**********',
+      '**********',
+    ]);
+    expect(identities[4].label).toBe('te******23');
+    for (const entry of identities) expect(Object.keys(entry).sort()).toEqual(['id', 'label']);
+    expect(JSON.stringify(identities)).not.toContain(keys[4]);
+  });
+});
+
+describe('plugin client-key directory requests', () => {
+  test('retrieves keys in the parent with the bridge AbortSignal and returns safe labels', async () => {
+    const controller = new AbortController();
+    const calls: unknown[] = [];
+    apiClient.get = (async (path, options) => {
+      calls.push({ path, signal: options?.signal });
+      return { 'api-keys': ['test-client-key-abc123'] };
+    }) as typeof apiClient.get;
+    const response = await requestPluginResource(
+      { method: 'GET', path: directoryPath },
+      controller.signal
+    );
+    expect(calls).toEqual([{ path: '/api-keys', signal: controller.signal }]);
+    expect(response).toMatchObject({ keys: [{ label: 'te******23' }] });
+    expect(JSON.stringify(response)).not.toContain('test-client-key-abc123');
+  });
+
+  test('does not cache keys between requests or connections', async () => {
+    let calls = 0;
+    apiClient.get = (async () => ({
+      'api-keys': [++calls === 1 ? 'first-client-key-12' : 'second-client-key-34'],
+    })) as typeof apiClient.get;
+    const signal = new AbortController().signal;
+    const first = await requestPluginResource({ method: 'GET', path: directoryPath }, signal);
+    const second = await requestPluginResource({ method: 'GET', path: directoryPath }, signal);
+    expect(calls).toBe(2);
+    expect(first).toMatchObject({ keys: [{ label: 'fi******12' }] });
+    expect(second).toMatchObject({ keys: [{ label: 'se******34' }] });
+  });
+
+  test('intercepts only the exact GET directory operation', async () => {
+    const calls: { method: string; path: string }[] = [];
+    apiClient.get = (async (path) => {
+      calls.push({ method: 'GET', path });
+      return {};
+    }) as typeof apiClient.get;
+    apiClient.put = (async (path) => {
+      calls.push({ method: 'PUT', path });
+      return {};
+    }) as typeof apiClient.put;
+    apiClient.post = (async (path) => {
+      calls.push({ method: 'POST', path });
+      return {};
+    }) as typeof apiClient.post;
+    const signal = new AbortController().signal;
+    for (const path of [
+      `${directoryPath}/`,
+      `${directoryPath}?page=1`,
+      '/plugins/other/client-keys',
+    ]) {
+      await requestPluginResource({ method: 'GET', path }, signal);
+    }
+    await requestPluginResource({ method: 'PUT', path: directoryPath }, signal);
+    await requestPluginResource({ method: 'POST', path: directoryPath }, signal);
+    expect(calls).toHaveLength(5);
