+describe('plugin bridge sessions', () => {
+  test('exchanges context and refresh without exposing a management key', () => {
+    const h = harness();
+    h.receive({ type: 'ready' });
+    h.bridge.updateContext({ theme: 'light', language: 'en' });
+    expect(h.bridge.refresh()).toBe(true);
+    expect(h.sent).toEqual([
+      {
+        origin,
+        data: h.envelope({
+          type: 'init',
+          sessionId: 'session-1',
+          pluginId,
+          theme: 'dark',
+          language: 'zh-CN',
+        }),
+      },
+      {
+        origin,
+        data: h.envelope({
+          type: 'init',
+          sessionId: 'session-1',
+          pluginId,
+          theme: 'light',
+          language: 'en',
+        }),
+      },
+      { origin, data: h.envelope({ type: 'refresh', sessionId: 'session-1' }) },
+    ]);
+  });
+
+  test('rejects other windows, spoofed origins, protocol versions and stale sessions', () => {
+    const h = harness();
+    const ready = h.envelope({ type: 'ready' });
+    h.bridge.receive({ source: {}, origin, data: ready });
+    h.bridge.receive({ source: h.frame, origin: `${origin}.attacker.example`, data: ready });
+    h.bridge.receive({ source: h.frame, origin: 'null', data: ready });
+    h.receive({ type: 'ready', version: 2 });
+    h.query({ sessionId: 'stale-session' });
+    expect(h.sent).toHaveLength(0);
+    expect(h.calls).toHaveLength(0);
+  });
+
+  test('forwards validated requests and body, while rejecting unapproved actions', async () => {
+    const h = harness(async () => ({ saved: true }));
+    h.query({ method: 'PUT', path: '/billing', body: { timezone: 'Asia/Shanghai' } });
+    h.query({ id: 'forbidden', method: 'PUT', path: '/config', body: {} });
+    await tick();
+    expect(h.calls).toHaveLength(1);
+    expect(h.calls[0].request).toEqual({
+      method: 'PUT',
+      path: `/plugins/${pluginId}/billing`,
+      body: { timezone: 'Asia/Shanghai' },
+    });
+    expect(h.sent.map((item) => item.data)).toContainEqual(
+      h.envelope({
+        type: 'response',
+        id: 'request-1',
+        sessionId: 'session-1',
+        ok: true,
+        data: { saved: true },
+      })
+    );
+    expect(h.sent.map((item) => item.data)).toContainEqual(
+      h.envelope({
+        type: 'response',
+        id: 'forbidden',
+        sessionId: 'session-1',
+        ok: false,
+        error: { message: 'Plugin request is not allowed.' },
+      })
+    );
+  });
+
+  test('frame reload cancels pending work and discards old results, including reused IDs', async () => {
+    const first = deferred<object>();
+    const second = deferred<object>();
+    let requests = 0;
+    const h = harness(() => (++requests === 1 ? first.promise : second.promise));
+    h.query();
+    h.query();
+    expect(h.calls).toHaveLength(1);
+    h.bridge.reset();
+    expect(h.calls[0].signal.aborted).toBe(true);
+    h.query();
+    expect(h.calls).toHaveLength(1);
+    h.query({ sessionId: 'session-2' });
+    first.resolve({ old: true });
+    await tick();
+    h.query({ sessionId: 'session-2' });
+    expect(h.calls).toHaveLength(2);
+    second.resolve({ fresh: true });
+    await tick();
+    expect(h.sent).toHaveLength(2);
+    expect(h.sent[1].data).toEqual(
+      h.envelope({
+        type: 'response',
+        id: 'request-1',
+        sessionId: 'session-2',
+        ok: true,
+        data: { fresh: true },
+      })
+    );
+  });
+
+  test('logout/disposal is irreversible and blocks both late successes and errors', async () => {
+    const success = deferred<object>();
+    const failure = deferred<object>();
+    const h = harness((request) =>
+      request.path.endsWith('/usage') ? success.promise : failure.promise
+    );
+    h.query();
+    h.query({ id: 'failure', path: '/billing' });
+    h.setCurrent(false);
+    h.bridge.dispose();
+    h.setCurrent(true);
+    success.resolve({ sensitive: 'old connection data' });
+    failure.reject(new Error('old connection error'));
+    await tick();
+    h.query({ id: 'after-logout' });
+    expect(h.calls).toHaveLength(2);
+    expect(h.calls.every((call) => call.signal.aborted)).toBe(true);
+    expect(h.bridge.refresh()).toBe(false);
+    expect(h.sent).toHaveLength(0);
+  });
+
+  test('checks connection scope again before delivering a response', async () => {
+    const response = deferred<object>();
+    const h = harness(() => response.promise);
+    h.query();
+    h.setCurrent(false);
+    response.resolve({ sensitive: 'previous server' });
+    await tick();
+    expect(h.sent).toHaveLength(0);
+    h.receive({ type: 'ready' });
+    expect(h.sent).toHaveLength(0);
+  });
+
+  test('returns status without forwarding error details or credentials', async () => {
+    const h = harness(async () => {
+      throw Object.assign(new Error('Bearer test-secret'), {
+        status: 503,
+        config: { headers: { Authorization: 'Bearer test-secret' } },
+        details: { secret: 'test-secret' },
+      });
+    });
+    h.query({ path: '/client-keys' });
+    await tick();
+    expect(h.sent[0].data).toEqual(
+      h.envelope({
+        type: 'response',
+        id: 'request-1',
+        sessionId: 'session-1',
+        ok: false,
+        error: { message: 'Plugin request failed.', status: 503 },
+      })
+    );
+    expect(JSON.stringify(h.sent)).not.toContain('test-secret');
+  });
+
+  test('discards a client-key directory response after session replacement', async () => {
+    const response = deferred<object>();
+    const h = harness(() => response.promise);
+    h.query({ path: '/client-keys' });
+    expect(h.calls[0].request.path).toBe(`/plugins/${pluginId}/client-keys`);
+    h.bridge.reset();
+    expect(h.calls[0].signal.aborted).toBe(true);
+    response.resolve({ keys: [{ id: 'key-old-session', label: 'ol******ey' }] });
+    await tick();
+    expect(h.sent).toHaveLength(1);
+    expect(JSON.stringify(h.sent)).not.toContain('key-old-session');
+  });
+});
