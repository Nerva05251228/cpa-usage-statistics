+
+  test('drops a response if its session signal was aborted while reading keys', async () => {
+    const controller = new AbortController();
+    apiClient.get = (async () => {
+      controller.abort();
+      return { 'api-keys': ['test-old-session-key'] };
+    }) as typeof apiClient.get;
+    await expect(
+      requestPluginResource({ method: 'GET', path: directoryPath }, controller.signal)
+    ).rejects.toThrow();
+  });
+
+  test('preserves the optional API-key list contract for existing callers', async () => {
+    apiClient.get = (async (path, options) => {
+      expect(path).toBe('/api-keys');
+      expect(options).toBeUndefined();
+      return { apiKeys: ['test-client-key'] };
+    }) as typeof apiClient.get;
+    expect(await apiKeysApi.list()).toEqual(['test-client-key']);
+  });
+});
